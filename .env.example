# Copy this file to .env and enter your Microsoft Entra application and tenant IDs.
# VITE_* values are exposed to the browser; do not put client secrets here.
VITE_APP_CLIENT_ID=""
VITE_APP_TENANT_ID=""
# Register this exact URI as a Single-page application redirect URI in Microsoft Entra.
VITE_APP_REDIRECT_URI="http://localhost:5173/fm-farm-ui-docs/redirect"

# Set to true in .env.local to skip sign-in on loopback hosts during development.
# Production builds always require authentication, regardless of this flag.
VITE_APP_BYPASS_AUTH=false

# The application base path is configured in vite.config.js.
# Vite supplies import.meta.env.BASE_URL automatically.